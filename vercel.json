{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dionsherifi.vercel.app"
        }
      ],
      "destination": "https://dionsherifi.com/:path*",
      "permanent": true
    },
    {
      "source": "/article.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.*)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    }
  ]
}
